{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moonquake2004.github.io/tower-atlas/assets/data/towers.schema.json",
  "title": "输电铁塔型式图鉴数据集",
  "description": "towers.json 的结构定义。新增塔型或修改参数时以本 schema 为准。",
  "type": "object",
  "required": ["meta", "shapeCatalog", "towers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["title", "version", "updated", "unitLength"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "语义化版本。字段增删或含义变更时升主/次版本号。"
        },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "unitLength": { "enum": ["m"] },
        "rangeConvention": { "type": "string" }
      }
    },

    "shapeCatalog": {
      "type": "object",
      "description": "型式注册表。key 即 tower.shape，必须与 assets/viewer3d.js 与 assets/ui/d_svg.js 的分支一一对应。",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "note"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 },
          "branch": {
            "type": "boolean",
            "default": true,
            "description": "是否已实现三维与立面渲染分支。false 表示仅有数据、无图形。"
          }
        }
      }
    },

    "towers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/tower" }
    }
  },

  "definitions": {
    "range": {
      "type": "object",
      "description": "资料给出的参数区间。null 表示资料未给出，不等于 0。",
      "required": ["text", "min", "max"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "界面展示用的原始文本，与 min/max 必须一致（由 validate.py 校验）。"
        },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "note": {
          "type": ["string", "null"],
          "description": "原文括号内的限定语，如「柱距」「一般段」。"
        },
        "approx": {
          "type": "boolean",
          "default": false,
          "description": "原文为「约」「~」等近似表述。"
        },
        "openEnded": {
          "enum": ["upper", "lower", null],
          "default": null,
          "description": "原文为「≤」或「≥」，对应一侧的 min/max 为 null。"
        }
      }
    },

    "tower": {
      "type": "object",
      "required": [
        "id", "name", "shape", "voltage", "circuit", "func", "code",
        "ranges", "spec", "render", "apply", "desc", "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$",
          "description": "稳定标识，用于 URL 片段 #/t/<id>，一旦发布不可更改。"
        },
        "name": { "type": "string", "minLength": 2 },
        "shape": {
          "type": "string",
          "description": "型式标识，必须存在于 shapeCatalog。"
        },
        "voltage": { "type": "string", "minLength": 2 },
        "circuit": { "type": "string", "minLength": 1 },
        "func": {
          "type": "string",
          "description": "功能定位：直线 / 耐张/转角 / 跨越 / 换位 / 终端 等。"
        },
        "code": { "type": "string", "minLength": 1 },

        "ranges": {
          "type": "object",
          "required": ["hCall", "hTotal", "rootOpen"],
          "additionalProperties": false,
          "properties": {
            "hCall": { "$ref": "#/definitions/range" },
            "hTotal": { "$ref": "#/definitions/range" },
            "rootOpen": { "$ref": "#/definitions/range" }
          }
        },

        "spec": {
          "type": "object",
          "required": [
            "conductor", "bundle", "bundleSource", "gw",
            "insulator", "insulatorType", "insulatorTypeSource",
            "wind", "ice", "weight", "spanH"
          ],
          "additionalProperties": false,
          "properties": {
            "conductor": { "type": "string", "minLength": 1 },
            "bundle": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 8,
              "description": "分裂数（每相/每极的子导线根数）。null 表示原文未给出。"
            },
            "bundleSource": {
              "enum": ["text", "manual", "unknown"],
              "description": "text = 由 conductor 文本解析；manual = 人工裁定；unknown = 原文未给出。"
            },
            "bundleNote": { "type": ["string", "null"] },
            "gw": { "type": "string", "minLength": 1 },
            "insulator": { "type": "string", "minLength": 1 },
            "insulatorType": {
              "enum": ["I", "V", "II", "T"],
              "description": "I=单悬垂串 V=V 形串 II=双串 T=耐张串。三维按单一型式示意。"
            },
            "insulatorTypeSource": { "enum": ["text", "manual"] },
            "insulatorNote": { "type": ["string", "null"] },
            "wind": { "type": "string", "minLength": 1 },
            "ice": { "type": "string", "minLength": 1 },
            "weight": { "type": "string", "minLength": 1 },
            "spanH": { "type": "string", "minLength": 1 }
          }
        },

        "render": {
          "type": "object",
          "description": "三维模型的基准尺寸。不是工程尺寸，只是用于生成示意图。",
          "required": ["height", "rootOpen", "arrangement", "callBasis"],
          "additionalProperties": false,
          "properties": {
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "三维模型全高（米）。必须落在 ranges.hTotal 区间内（未给出区间时不做检查）。"
            },
            "rootOpen": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "三维模型根开（米）。必须落在 ranges.rootOpen 区间内（未给出区间时不做检查）。"
            },
            "arrangement": { "type": "string", "minLength": 1 },
            "callBasis": {
              "enum": ["hCall", "attachment"],
              "description": "hCall = 资料给出了呼称高；attachment = 未给出，标注显示「导线挂点」。几何算出的挂点高度 > 0.90×全高时，渲染器一律显示「导线挂点」，与本字段无关。"
            }
          }
        },

        "apply": { "type": "string", "minLength": 2 },
        "desc": { "type": "string", "minLength": 20 },

        "source": {
          "type": "object",
          "required": ["verified", "line"],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "boolean",
              "description": "true = 关键参数已与一手资料核对；false = 取典型值示意。"
            },
            "line": { "type": "string", "minLength": 4 }
          }
        }
      }
    }
  }
}
